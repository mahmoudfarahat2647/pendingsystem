# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.tmp
*.swp
.idea/
*.pem

# scratch/temporary files
git_diff.txt
pr_description.md
*.resolved

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.local

# vercel
/.vercel/

# AI Tools
/.agents/
/.claude/
/.cursor/

# mcp configs
.mcp.json
mcp.json
.vscode/mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Git worktrees
.worktrees/
/playwright-report/
e2e/.auth/
.playwright-cli/

# documentation (Obsidian vault is local-only, but ADRs must be tracked:
# an architecture decision record only does its job if future readers can read it)
/docs/*
!/docs/adr/

# scripts (utility scripts ignored, but tracked infrastructure is excepted)
/scripts/*
!/scripts/docs-sync.sh
!/scripts/verify-db.mjs
!/scripts/prompts
/scripts/prompts/*
!/scripts/prompts/docs-triage.md
!/scripts/prompts/docs-ingest.md

# CLAUDE.md
CLAUDE.md
